# RingCentral — server-only (never use VITE_)
RINGCENTRAL_CLIENT_ID=
RINGCENTRAL_CLIENT_SECRET=
RINGCENTRAL_JWT=
RINGCENTRAL_SERVER_URL=https://platform.ringcentral.com
RINGCENTRAL_FROM_NUMBER=+17085754555
RINGCENTRAL_WEBHOOK_VALIDATION_TOKEN=

# xAI / Grok — server-only (never use VITE_)
XAI_API_KEY=
